{
  "name": "@braintied/research",
  "version": "1.5.1",
  "description": "Cited research with a budget. Free search/fetch via SearXNG + Crawl4AI. Multi-provider lanes, typed credentials, grounded citations.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm run build && npm run test:unit && npm run test:instagram",
    "test:unit": "tsx --test test/*.test.ts",
    "test:instagram": "node --test tests/instagram-brightdata.test.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack:release": "npm run clean && npm run build && npm pack --pack-destination ./releases",
    "smoke:searxng": "npx tsx scripts/smoke-test-searxng.ts",
    "smoke:crawl4ai": "npx tsx scripts/smoke-test-crawl4ai.ts",
    "eval:baseline": "tsx evals/run-baseline.ts",
    "eval:ablation": "tsx evals/run-fanout-ablation.ts"
  },
  "keywords": [
    "research",
    "deep-research",
    "ai",
    "search",
    "synthesis",
    "content-generation",
    "prd",
    "document-generation"
  ],
  "author": "Braintied",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braintied/research.git"
  },
  "homepage": "https://github.com/braintied/research#readme",
  "bugs": {
    "url": "https://github.com/braintied/research/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "zod": "^4.4.3",
    "@google/genai": "^2.13.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@braintied/cost": "3.1.0",
    "@braintied/models": "1.7.2",
    "@anthropic-ai/sdk": "^0.104.2",
    "openai": "^7.0.0",
    "youtube-transcript": "^1.3.1",
    "youtube-transcript-plus": "^1.2.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@google/genai": "^2.13.0",
    "@types/node": "^22.19.17",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "braintied": {
    "tier": "engine"
  }
}
